# EditorConfig — keeps formatting consistent across editors. Copy to `.editorconfig`.
# Most editors support it (some need a plugin). See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,go}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false  # trailing spaces are meaningful (line breaks) in Markdown

[Makefile]
indent_style = tab

# Windows batch/PowerShell often expect CRLF
[*.{bat,cmd,ps1}]
end_of_line = crlf
